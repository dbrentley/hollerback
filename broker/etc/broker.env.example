# Copy to ~/.config/hollerback/broker.env
#
# Bind to the Tailscale IP only -- reachable from tailnet peers, invisible to
# the LAN and the internet. This mirrors how daoc-admin-mcp is exposed.
# 127.0.0.1 keeps the broker on this machine only -- correct for several
# sessions on one box. To share it across machines, bind the private
# address other machines reach you on (e.g. a Tailscale 100.x IP).
# NEVER bind 0.0.0.0 on an untrusted network: there is no auth.
HOLLERBACK_BIND=127.0.0.1
HOLLERBACK_PORT=8850

# Optional shared bearer token. Leave empty to disable auth (tailnet-only
# protection). Set it on the broker AND in each machine's plugin config.
HOLLERBACK_TOKEN=

# How many messages to hold for an agent that has no session connected.
HOLLERBACK_BACKLOG_MAX=200

# SSE keepalive interval, seconds.
HOLLERBACK_KEEPALIVE_SECS=20
